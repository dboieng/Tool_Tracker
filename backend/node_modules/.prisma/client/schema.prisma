// Tool Tracker — standalone schema (SQLite so it runs with no database server).
//
// MERGING INTO TRADIES DIARY: copy the four models below into the main
// prisma/schema.prisma (MySQL). See MERGE_GUIDE.md for the two small extra lines
// (Organisation relation) and the migrate command. Table names already use the
// td_ prefix like the rest of Tradies Diary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One Walter gateway = one toolbox.
model ToolTrackerDevice {
  id             Int                 @id @default(autoincrement())
  uuid           String              @unique @default(uuid())
  organisationId Int                 @map("organisation_id")
  name           String
  keyHash        String              @unique @map("key_hash") // sha256 of the device key; the key itself is never stored
  lastReportOn   DateTime?           @map("last_report_on")
  batteryV       Float?              @map("battery_v")
  latitude       Float?
  longitude      Float?
  gpsAccuracyM   Float?              @map("gps_accuracy_m")
  gpsOn          DateTime?           @map("gps_on") // when the last good GPS fix was received
  lteRsrp        Int?                @map("lte_rsrp")
  createdOn      DateTime            @default(now()) @map("created_on")
  updatedOn      DateTime            @updatedAt @map("updated_on")
  deleteFlag     Boolean             @default(false) @map("delete_flag")
  reports        ToolTrackerReport[]

  @@index([organisationId])
  @@map("td_tool_tracker_device")
}

// One iBS05 tag stuck on one tool. Holds the tool's CURRENT state.
model ToolTrackerTag {
  id             Int                     @id @default(autoincrement())
  uuid           String                  @unique @default(uuid())
  organisationId Int                     @map("organisation_id")
  mac            String // aa:bb:cc:dd:ee:ff, lower case
  name           String
  notes          String?
  toolInfoId     Int?                    @map("tool_info_id") // optional link to Tradies Diary's existing tool list (td_tool_info)
  inBox          Boolean                 @default(false) @map("in_box")
  lastSeenOn     DateTime?               @map("last_seen_on") // heard at all (in or out of the box)
  lastInBoxOn    DateTime?               @map("last_in_box_on") // last report that had it IN the box
  lastRssi       Int?                    @map("last_rssi")
  batteryV       Float?                  @map("battery_v")
  lastDeviceId   Int?                    @map("last_device_id") // which toolbox it was last in
  createdOn      DateTime                @default(now()) @map("created_on")
  updatedOn      DateTime                @updatedAt @map("updated_on")
  deleteFlag     Boolean                 @default(false) @map("delete_flag")
  items          ToolTrackerReportItem[]

  @@unique([organisationId, mac])
  @@map("td_tool_tracker_tag")
}

// One message from Walter (e.g. once a day, or when the lid closes).
model ToolTrackerReport {
  id             Int                     @id @default(autoincrement())
  uuid           String                  @unique @default(uuid())
  organisationId Int                     @map("organisation_id")
  deviceId       Int                     @map("device_id")
  device         ToolTrackerDevice       @relation(fields: [deviceId], references: [id])
  receivedOn     DateTime                @default(now()) @map("received_on")
  batteryV       Float?                  @map("battery_v")
  latitude       Float?
  longitude      Float?
  gpsAccuracyM   Float?                  @map("gps_accuracy_m")
  lteRsrp        Int?                    @map("lte_rsrp")
  lidClosed      Boolean?                @map("lid_closed")
  firmware       String?
  items          ToolTrackerReportItem[]

  @@index([deviceId, receivedOn])
  @@index([organisationId, receivedOn])
  @@map("td_tool_tracker_report")
}

// One line per tag in a report. change = "RETURNED" / "LEFT" when the tool's state flipped.
model ToolTrackerReportItem {
  id        Int               @id @default(autoincrement())
  reportId  Int               @map("report_id")
  report    ToolTrackerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tagId     Int?              @map("tag_id") // null = unknown tag (not in the tool list yet)
  tag       ToolTrackerTag?   @relation(fields: [tagId], references: [id])
  mac       String
  inBox     Boolean           @map("in_box")
  heard     Boolean           @default(true)
  rssi      Int?
  strongPct Int?              @map("strong_pct")
  batteryV  Float?            @map("battery_v")
  change    String? // RETURNED | LEFT | null

  @@index([reportId])
  @@index([tagId])
  @@index([mac])
  @@map("td_tool_tracker_report_item")
}
