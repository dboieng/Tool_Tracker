# Copy this file to .env  (cp .env.example .env)

# SQLite database file (created by "npm run db:push")
DATABASE_URL="file:./tooltracker.db"

# Port the server listens on
PORT=3100

# Password for the web page (pick your own long random text)
DASHBOARD_TOKEN="dcb"

# Which organisation this standalone copy pretends to be (Tradies Diary org id)
ORG_ID=1
